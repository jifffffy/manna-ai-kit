{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manna.dev/schemas/project-spec.schema.json",
  "title": "Manna Project Spec",
  "type": "object",
  "required": [
    "project",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "artifactId",
        "groupId",
        "package",
        "designMode"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "groupId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.]*$"
        },
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
        },
        "version": {
          "type": "string",
          "default": "0.1.0"
        },
        "description": {
          "type": "string"
        },
        "designMode": {
          "enum": [
            "graph-first",
            "capability-first"
          ],
          "default": "graph-first"
        },
        "javaVersion": {
          "type": "string",
          "default": "21"
        },
        "embabelVersion": {
          "type": "string",
          "default": "1.5.4"
        },
        "springBootVersion": {
          "type": "string",
          "default": "3.5.13"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://manna.dev/schemas/capability-spec.schema.json#/$defs/capability"
      }
    }
  }
}
