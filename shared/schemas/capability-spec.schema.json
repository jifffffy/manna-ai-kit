{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manna.dev/schemas/capability-spec.schema.json",
  "title": "Manna Capability Spec",
  "type": "object",
  "$defs": {
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "className",
        "capability",
        "agent",
        "tools",
        "domain",
        "graph",
        "memory",
        "pipeline",
        "transport",
        "evals"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3,}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "className": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "capability": {
          "type": "object",
          "required": [
            "user_intent",
            "acceptance",
            "non_goals"
          ],
          "additionalProperties": false,
          "properties": {
            "user_intent": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "non_goals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "agent": {
          "type": "object",
          "required": [
            "mode",
            "description",
            "goal"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "utility",
                "structured"
              ]
            },
            "description": {
              "type": "string"
            },
            "goal": {
              "type": "string"
            },
            "opaque": {
              "type": "boolean",
              "default": true
            },
            "confirmations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "https://manna.dev/schemas/tool-contract.schema.json"
          }
        },
        "domain": {
          "type": "object",
          "required": [
            "entities",
            "relations",
            "invariants"
          ],
          "additionalProperties": false,
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "description",
                  "fields"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*$"
                  },
                  "description": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "type"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "String",
                            "int",
                            "long",
                            "double",
                            "boolean",
                            "Instant",
                            "List<String>"
                          ]
                        },
                        "required": {
                          "type": "boolean",
                          "default": true
                        }
                      }
                    }
                  }
                }
              }
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "type",
                  "to"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "to": {
                    "type": "string"
                  },
                  "direction": {
                    "enum": [
                      "OUTGOING",
                      "INCOMING"
                    ],
                    "default": "OUTGOING"
                  }
                }
              }
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "graph": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "read_only": {
              "type": "boolean",
              "default": true
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "queries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "propositions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "recall": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100,
                  "default": 10
                },
                "order": {
                  "type": "string",
                  "default": "effectiveConfidence"
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "pipeline": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "format": {
              "enum": [
                "csv",
                "jsonl"
              ],
              "default": "csv"
            },
            "review": {
              "enum": [
                "csv-git",
                "jsonl-git",
                "none"
              ],
              "default": "csv-git"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "apply": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "approved-only",
                    "all",
                    "none"
                  ],
                  "default": "approved-only"
                },
                "idempotent": {
                  "type": "boolean",
                  "default": true
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "transport": {
          "type": "object",
          "required": [
            "http",
            "sse"
          ],
          "additionalProperties": false,
          "properties": {
            "http": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sse": {
              "type": "boolean"
            },
            "cli": {
              "type": "boolean",
              "default": false
            },
            "mcp": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "evals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  },
  "$ref": "#/$defs/capability"
}
