{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manna.dev/schemas/domain-slice.schema.json",
  "title": "Manna Domain Slice",
  "type": "object",
  "required": ["capability_id", "entities", "relations", "invariants"],
  "additionalProperties": false,
  "properties": {
    "capability_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "fields"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                "type": { "enum": ["String", "int", "long", "double", "boolean", "Instant", "List<String>"] },
                "required": { "type": "boolean", "default": true }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "type", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "to": { "type": "string" },
          "direction": { "enum": ["OUTGOING", "INCOMING"], "default": "OUTGOING" }
        }
      }
    },
    "invariants": { "type": "array", "items": { "type": "string" } }
  }
}
