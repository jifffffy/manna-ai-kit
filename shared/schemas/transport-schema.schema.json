{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manna.dev/schemas/transport-schema.schema.json",
  "title": "Manna Transport Schema",
  "type": "object",
  "required": ["capability_id", "http", "sse"],
  "additionalProperties": false,
  "properties": {
    "capability_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "http": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "request", "response"],
        "additionalProperties": false,
        "properties": {
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string", "pattern": "^/" },
          "request": { "type": "string" },
          "response": { "type": "string" },
          "auth": { "enum": ["none", "api-key", "oauth2", "jwt"], "default": "api-key" }
        }
      }
    },
    "sse": { "type": "boolean" },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "command": { "type": "string" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
