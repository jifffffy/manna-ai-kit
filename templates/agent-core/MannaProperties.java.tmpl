package {{package}};

import org.springframework.boot.context.properties.ConfigurationProperties;

@ConfigurationProperties(prefix = "manna")
public record MannaProperties(
        String name,
        String objective,
        String systemPrompt,
        String dataDir
) {
    public MannaProperties {
        if (name == null || name.isBlank()) {
            name = "{{name}}";
        }
        if (objective == null) {
            objective = "";
        }
        if (dataDir == null || dataDir.isBlank()) {
            dataDir = "data";
        }
    }
}
