{
  "id": "F-002",
  "name": "Save To Agenda",
  "className": "SaveToAgenda",
  "package": "savetoagenda",
  "capability": {
    "user_intent": [
      "Save a chosen conference session to the user's agenda"
    ],
    "acceptance": [
      "Asks for confirmation before writing to the agenda service",
      "Returns the created AgendaEntry id and session id",
      "Repeating the same request does not create a duplicate entry"
    ],
    "non_goals": [
      "Editing or deleting agenda entries",
      "Creating calendar invites"
    ]
  },
  "agent": {
    "mode": "structured",
    "description": "Save a session to the user's agenda after confirmation.",
    "goal": "Create exactly one agenda entry for the requested session.",
    "opaque": true,
    "confirmations": [
      "before addToAgenda"
    ]
  },
  "tools": [
    {
      "name": "addToAgenda",
      "description": "Add a session to the user's external agenda. Requires confirmation.",
      "kind": "http",
      "side_effects": "external-write",
      "idempotent": true,
      "idempotency_key": "userId + sessionId",
      "approval": "required",
      "dry_run": true,
      "timeout_seconds": 20,
      "secrets": ["AGENDA_API_TOKEN"],
      "input": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" }
        },
        "required": ["sessionId"]
      },
      "output": {
        "type": "object",
        "properties": {
          "entryId": { "type": "string" }
        }
      }
    }
  ],
  "domain": {
    "entities": [
      {
        "name": "AgendaEntry",
        "description": "A user's saved session in an external agenda.",
        "fields": [
          { "name": "id", "type": "String" },
          { "name": "sessionId", "type": "String" },
          { "name": "createdAt", "type": "Instant" }
        ]
      }
    ],
    "relations": [
      {
        "from": "AgendaEntry",
        "type": "REFERENCES",
        "to": "Session",
        "direction": "OUTGOING"
      }
    ],
    "invariants": [
      "AgendaEntry.id is unique",
      "AgendaEntry.sessionId resolves to a Session"
    ]
  },
  "graph": {
    "enabled": true,
    "read_only": true,
    "labels": ["AgendaEntry"],
    "relationships": ["REFERENCES"],
    "constraints": [
      "AgendaEntry.id is unique"
    ],
    "queries": [
      {
        "name": "entries_for_user",
        "cypher": "MATCH (e:AgendaEntry {userId: $userId}) RETURN e.id, e.sessionId LIMIT 100",
        "read_only": true
      }
    ]
  },
  "memory": {
    "enabled": false,
    "reason": "Agenda writes are user-scoped and do not need long-term preference memory for this slice."
  },
  "pipeline": {
    "enabled": false,
    "reason": "Agenda entries are created one at a time through the tool, not curated in bulk."
  },
  "transport": {
    "http": ["/api/capabilities/save-to-agenda"],
    "sse": false,
    "cli": false,
    "mcp": false
  },
  "evals": [
    "asks for confirmation before addToAgenda",
    "does not create a duplicate entry for the same session",
    "returns the entry id and session id"
  ]
}
