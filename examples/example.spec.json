{
  "project": {
    "name": "Session Scout",
    "artifactId": "session-scout",
    "groupId": "dev.manna.examples",
    "package": "dev.manna.session",
    "version": "0.1.0",
    "description": "A headless agent that helps attendees find conference sessions and save them to an agenda.",
    "designMode": "graph-first"
  },
  "capabilities": [
    {
      "id": "F-001",
      "name": "Find Sessions",
      "className": "FindSessions",
      "package": "findsessions",
      "capability": {
        "user_intent": [
          "Find conference sessions relevant to a topic or speaker"
        ],
        "acceptance": [
          "Returns at least one structured Session with id, title and track",
          "Every Session has a resolvable Speaker relation or an explicit null",
          "Never writes to an external system"
        ],
        "non_goals": [
          "Saving sessions to an agenda",
          "Creating calendar invites"
        ]
      },
      "agent": {
        "mode": "utility",
        "description": "Find conference sessions using the catalog search tool.",
        "goal": "Return relevant sessions with title, track, start time and speaker.",
        "opaque": false,
        "confirmations": []
      },
      "tools": [
        {
          "name": "searchSessions",
          "description": "Search the conference catalog by topic, track or speaker. Read-only.",
          "kind": "http",
          "side_effects": "read",
          "idempotent": true,
          "approval": "none",
          "timeout_seconds": 20,
          "secrets": [],
          "input": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ]
          },
          "output": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      ],
      "domain": {
        "entities": [
          {
            "name": "Session",
            "description": "A talk or workshop in the conference program.",
            "fields": [
              {
                "name": "id",
                "type": "String"
              },
              {
                "name": "title",
                "type": "String"
              },
              {
                "name": "abstractText",
                "type": "String"
              },
              {
                "name": "track",
                "type": "String"
              },
              {
                "name": "startsAt",
                "type": "Instant"
              }
            ]
          },
          {
            "name": "Speaker",
            "description": "A person presenting one or more sessions.",
            "fields": [
              {
                "name": "id",
                "type": "String"
              },
              {
                "name": "name",
                "type": "String"
              },
              {
                "name": "bio",
                "type": "String"
              }
            ]
          }
        ],
        "relations": [
          {
            "from": "Session",
            "type": "PRESENTED_BY",
            "to": "Speaker",
            "direction": "OUTGOING"
          }
        ],
        "invariants": [
          "Session.id is unique",
          "Session.startsAt is a valid instant",
          "A Session has zero or one primary Speaker in this slice"
        ]
      },
      "graph": {
        "enabled": true,
        "read_only": true,
        "labels": [
          "Session",
          "Speaker"
        ],
        "relationships": [
          "PRESENTED_BY"
        ],
        "constraints": [
          "Session.id is unique",
          "Speaker.id is unique"
        ],
        "queries": [
          {
            "name": "sessions_by_track",
            "cypher": "MATCH (s:Session {track: $track}) RETURN s.id, s.title, s.startsAt LIMIT 50",
            "read_only": true
          }
        ]
      },
      "memory": {
        "enabled": true,
        "context": "default",
        "propositions": [
          "User LIKES Topic",
          "User PREFERS Track"
        ],
        "relations": [
          "LIKES",
          "PREFERS"
        ],
        "recall": {
          "limit": 10,
          "order": "effectiveConfidence",
          "min_confidence": 0.3
        }
      },
      "pipeline": {
        "enabled": false,
        "reason": "The conference catalog is read from the live API; no curated data pipeline is needed for this slice."
      },
      "transport": {
        "http": [
          "/api/chat",
          "/api/chat/stream"
        ],
        "sse": true,
        "cli": false,
        "mcp": false
      },
      "evals": [
        "returns structured sessions for a topic query",
        "never calls a write tool",
        "does not recall irrelevant memory"
      ]
    }
  ]
}
