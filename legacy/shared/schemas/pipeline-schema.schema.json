{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manna.dev/schemas/pipeline-schema.schema.json",
  "title": "Manna Pipeline Schema",
  "type": "object",
  "required": ["capability_id", "enabled"],
  "additionalProperties": false,
  "properties": {
    "capability_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "enabled": { "type": "boolean" },
    "format": { "enum": ["csv", "jsonl"], "default": "csv" },
    "input": { "type": "string" },
    "output": { "type": "string" },
    "columns": { "type": "array", "items": { "type": "string" } },
    "review": {
      "type": "object",
      "required": ["mode", "status_column"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["csv-git", "jsonl-git", "none"] },
        "status_column": { "type": "string", "default": "status" },
        "approved_value": { "type": "string", "default": "approved" },
        "pending_value": { "type": "string", "default": "pending" },
        "rejected_value": { "type": "string", "default": "rejected" }
      }
    },
    "apply": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["approved-only", "all", "none"], "default": "approved-only" },
        "idempotent": { "type": "boolean", "default": true },
        "batch_size": { "type": "integer", "minimum": 1, "default": 100 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["delete-applied-ids", "snapshot", "none"], "default": "delete-applied-ids" },
        "ledger": { "type": "string", "default": ".manna/pipeline-applied.json" }
      }
    }
  }
}
