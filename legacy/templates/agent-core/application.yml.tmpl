server:
  port: ${PORT:8080}

spring:
  application:
    name: {{name}}
  neo4j:
    uri: ${NEO4J_URI:bolt://localhost:7687}
    authentication:
      username: ${NEO4J_USERNAME:neo4j}
      password: ${NEO4J_PASSWORD:manna}

manna:
  name: {{name}}
  objective: {{objective}}
  system-prompt: {{systemPrompt}}
  data-dir: ${MANNA_DATA_DIR:data}

embabel:
  models:
    default-llm:
      model: ${LLM_MODEL:gpt-4.1-mini}
    default-embedding-model:
      model: ${EMBEDDING_MODEL:text-embedding-3-small}

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: never
