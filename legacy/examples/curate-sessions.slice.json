{
  "id": "F-003",
  "name": "Curate Sessions",
  "className": "CurateSessions",
  "package": "curatesessions",
  "capability": {
    "user_intent": [
      "Curate imported session data before it enters the catalog"
    ],
    "acceptance": [
      "Writes candidates with id and status",
      "Applies only approved rows",
      "Re-applying the same rows creates no duplicates"
    ],
    "non_goals": [
      "Reviewing in a web UI",
      "Deleting raw source data"
    ]
  },
  "agent": {
    "mode": "utility",
    "description": "Explain the curation pipeline and read candidate rows.",
    "goal": "Help an operator understand and apply approved session candidates.",
    "opaque": false,
    "confirmations": [
      "before applying approved rows"
    ]
  },
  "tools": [
    {
      "name": "listCandidates",
      "description": "List pending session candidates from the CSV. Read-only.",
      "kind": "filesystem",
      "side_effects": "read",
      "idempotent": true,
      "approval": "none",
      "timeout_seconds": 5,
      "secrets": []
    }
  ],
  "domain": {
    "entities": [
      {
        "name": "CuratedSession",
        "description": "A session candidate under review.",
        "fields": [
          { "name": "id", "type": "String" },
          { "name": "title", "type": "String" },
          { "name": "track", "type": "String" },
          { "name": "status", "type": "String" }
        ]
      }
    ],
    "relations": [],
    "invariants": [
      "CuratedSession.id is unique",
      "status is pending, approved or rejected"
    ]
  },
  "graph": {
    "enabled": true,
    "read_only": true,
    "labels": ["CuratedSession"],
    "relationships": [],
    "constraints": ["CuratedSession.id is unique"],
    "queries": [
      {
        "name": "approved_sessions",
        "cypher": "MATCH (s:CuratedSession {status: 'approved'}) RETURN s.id, s.title LIMIT 100",
        "read_only": true
      }
    ]
  },
  "memory": {
    "enabled": false,
    "reason": "Curation is an operator workflow; remembering operator preferences is out of scope."
  },
  "pipeline": {
    "enabled": true,
    "format": "csv",
    "review": "csv-git",
    "columns": ["id", "status", "title", "track"],
    "apply": {
      "mode": "approved-only",
      "idempotent": true
    }
  },
  "transport": {
    "http": ["/api/chat"],
    "sse": true,
    "cli": true,
    "mcp": false
  },
  "evals": [
    "applies only approved rows",
    "applying twice is a no-op",
    "rejected rows remain in the file"
  ]
}
