{
  "name": "manna-ai-kit",
  "version": "0.1.0",
  "description": "Natural-language development orchestrator for the Urbot JVM bot platform.",
  "type": "module",
  "bin": {
    "manna": "generator/manna.mjs"
  },
  "scripts": {
    "validate": "node scripts/dev/validate-kit.mjs",
    "lock": "node scripts/dev/update-lock.mjs",
    "lock:check": "node scripts/dev/update-lock.mjs --check",
    "check:positioning": "node scripts/dev/check-positioning.mjs",
    "check:urbot-only": "node scripts/dev/check-urbot-only.mjs",
    "test:routing": "node scripts/dev/test-routing.mjs",
    "test:profile": "node scripts/dev/test-profile-change.mjs",
    "test:tool": "node scripts/dev/test-tool-development.mjs",
    "test:domain": "node scripts/dev/test-domain-design.mjs",
    "test": "node scripts/dev/check-positioning.mjs && node scripts/dev/check-urbot-only.mjs && node scripts/dev/test-routing.mjs && node scripts/dev/test-profile-change.mjs && node scripts/dev/test-tool-development.mjs && node scripts/dev/test-domain-design.mjs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "NOTICE",
    "LICENSE",
    "skills.json",
    "skills.lock",
    ".well-known/",
    ".claude-plugin/",
    "skills/",
    "shared/",
    "workflows/",
    "policies/",
    "generator/",
    "docs/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/embabel/manna-ai-kit"
  },
  "license": "Apache-2.0",
  "keywords": [
    "embabel",
    "agent",
    "tools",
    "mcp",
    "neo4j",
    "dice",
    "ai-kit",
    "urbot",
    "orchestrator"
  ]
}
